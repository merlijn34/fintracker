meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}


body:json {
  {
    "email": "{{testEmail}}",
    "password": "password123",
    "firstName": "Test",
    "lastName": "User"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3001
}

script:pre-request {
  const randomId = Math.floor(Math.random() * 100000);
  bru.setVar("testEmail", `user${randomId}@example.com`);
}
